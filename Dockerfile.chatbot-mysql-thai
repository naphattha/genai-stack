FROM python:3.10-slim

WORKDIR /app
# Copy shared requirements
COPY ./src/chatbot/requirements.txt /app/requirements.txt

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

COPY ./src/chatbot/mysql_THAI /app

CMD ["streamlit", "run", "bot.py", "--server.port=8504", "--server.address=0.0.0.0"]
